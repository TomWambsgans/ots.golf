import OptimalOTS.OracleAlgorithm

/-! Upper bound in compressions: an oracle-algorithm scheme (`OracleAlgorithm.lean`). -/

namespace OptimalOTS.Challenge.UpperCompressions

/-- The submitted key-generation, signing, and verification algorithms. -/
noncomputable def scheme : AlgorithmScheme paperParams := sorry

/-- Correctness, deterministic verification, signing failure at most `2⁻¹²⁸`, and the
competition's size and cost limits. -/
theorem admissible :
    scheme.Admissible AlgorithmScheme.paperLimits (1 / 2 ^ 128) := sorry

/-- Strong unforgeability in the shared random-oracle experiment. -/
theorem secure : scheme.Secure := sorry

/-- Verification costs at most `{{CLAIM}}` compressions on every input and oracle-answer path. -/
theorem cost : scheme.VerifyCostAtMost {{CLAIM}} := sorry

end OptimalOTS.Challenge.UpperCompressions
