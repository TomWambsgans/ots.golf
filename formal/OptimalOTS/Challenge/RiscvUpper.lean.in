import OptimalOTS.Riscv

/-! Upper bound in RISC-V cycles: an OTS and a machine image implementing its verifier
(`Riscv.lean`). -/

namespace OptimalOTS.Challenge.RiscvUpper

/-- The OTS, the machine image and the termination witness. -/
noncomputable def submission : Riscv.Submission := sorry

/-- Admissibility and strong security of the OTS, exact implementation of its verifier by the
image, and at most `{{CLAIM}}` cycles on every execution. -/
theorem certificate : submission.Certificate {{CLAIM}} := sorry

end OptimalOTS.Challenge.RiscvUpper
