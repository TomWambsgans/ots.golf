import OptimalOTS.Algorithm

/-! Generality 3/3 lower bound: oracle-algorithm schemes (`Algorithm.lean`). -/

namespace OptimalOTS.Challenge.GenericLower

/-- Every admissible (signing failure at most `2⁻¹²⁸`, the competition's limits), secure scheme
needs a verification budget of at least `{{CLAIM}}` compressions. -/
theorem candidate :
    AlgorithmVerificationLowerBound paperParams AlgorithmScheme.paperLimits (1 / 2 ^ 128) {{CLAIM}} := sorry

end OptimalOTS.Challenge.GenericLower
