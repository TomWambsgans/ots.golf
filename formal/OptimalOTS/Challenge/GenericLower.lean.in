import OptimalOTS.AlgorithmWeak

/-! The generic lower contract fixes perfect correctness, signing failure at most `2⁻¹²⁸`
for every public-key-dependent message choice, 127-bit fresh-message security, and the paper
size and resource limits. -/

namespace OptimalOTS.Challenge.GenericLower

/-- Every pathwise verification budget of an admissible secure oracle algorithm is at least
`{{CLAIM}}` compressions. -/
theorem candidate :
    AlgorithmVerificationLowerBound paperParams AlgorithmScheme.paperLimits (1 / 2 ^ 128) {{CLAIM}} := sorry

end OptimalOTS.Challenge.GenericLower
