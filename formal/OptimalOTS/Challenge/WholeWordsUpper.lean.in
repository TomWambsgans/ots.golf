import OptimalOTS.WholeWords

/-! Whole-word upper reference: a secure scheme in the Generality 1/3 class, witnessing that its
lower bound is not vacuous. Rendered with the reference claim. -/

namespace OptimalOTS.Challenge.WholeWordsUpper

/-- A graph-based one-time signature scheme with the parameters of the paper. -/
noncomputable def scheme : Scheme paperParams := sorry

/-- Every node computes whole 128-bit words. -/
theorem wholeWords : scheme.graph.WholeWords := sorry

/-- Strong unforgeability in the shared random-oracle experiment. -/
theorem secure : scheme.Secure := sorry

/-- Verification at every signature index costs at most `{{CLAIM}}` compressions. -/
theorem cost : ∀ i : Fin paperParams.numSets, scheme.verifyCost i ≤ {{CLAIM}} := sorry

end OptimalOTS.Challenge.WholeWordsUpper
